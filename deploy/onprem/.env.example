# Copy to .env and fill in. NEVER commit the real .env.
#
# Generate a 32-byte base64 KEK on an offline host:
#   head -c 32 /dev/urandom | base64

# Internal registry holding the mirrored images (see images.txt / mirror-images.sh).
KSEAL_REGISTRY=registry.internal.example.com
KSEAL_VERSION=0.1.0

# Mandatory secrets (server runs in prod mode → KEK required, fail-closed).
KSEAL_KEK=replace-with-base64-32-byte-key
KSEAL_PG_PASSWORD=replace-with-a-strong-postgres-password

# Optional Postgres identifiers.
KSEAL_PG_USER=kseal
KSEAL_PG_DB=kseal

# Bind only to loopback by default; set 0.0.0.0 to expose on the host network.
KSEAL_BIND_ADDR=127.0.0.1

# Tuning.
KSEAL_LOG_LEVEL=info
KSEAL_RATE_LIMIT_RPS=200
KSEAL_RATE_LIMIT_BURST=400
KSEAL_INGEST_QUOTA_PER_MIN=6000
KSEAL_RAW_RETENTION_DAYS=30

# Optional Redis security (WS-F contract). The bundled Redis runs on an isolated
# compose network with no host port published, so AUTH/TLS are off by default.
# Only set these when KSEAL_REDIS_ADDR points at an EXTERNAL Redis that requires
# them — the bundled Redis does not enable requirepass, so setting a password
# here while still using the bundled Redis would make the server fail AUTH.
# KSEAL_REDIS_ADDR=my-managed-redis:6379
# KSEAL_REDIS_TLS=true
# KSEAL_REDIS_PASSWORD=...
# KSEAL_REDIS_CA_FILE=/etc/kseal/redis-tls/ca.crt
