# Example inputs for the private-link module. Reference it from an environment
# root (e.g. deploy/terraform/envs/prod) like:
#
#   module "private_link" {
#     source = "../../modules/private-link"
#     name       = "kseal-prod-regulated"
#     vpc_id     = module.network.vpc_id
#     subnet_ids = module.network.private_subnet_ids
#     allowed_principals = [
#       "arn:aws:iam::222233334444:root", # regulated tenant A account
#     ]
#     tags = local.tags
#   }
#
# Then pass these values via terraform.tfvars at that root.

name       = "kseal-prod-regulated"
vpc_id     = "vpc-aaaaaaaa"
subnet_ids = ["subnet-aaaa", "subnet-bbbb", "subnet-cccc"]

target_port   = 8080
listener_port = 443

# Terminate TLS at the NLB with an ACM cert (recommended for regulated tenants).
# Leave empty for raw TCP passthrough to the server's h2c port.
tls_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/abcd-..."

# Manual acceptance + an explicit principal allow-list: no consumer can connect
# until both you accept their endpoint request and their principal is listed.
acceptance_required = true
allowed_principals = [
  "arn:aws:iam::222233334444:root",
  "arn:aws:iam::555566667777:root",
]

# Optional stable private DNS name (requires TXT domain verification).
enable_private_dns = true
private_dns_name   = "private.kseal.example.com"
