<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted ONLY for the local development trust endpoint reachable
  from the Android emulator (10.0.2.2 is the host loopback; 127.0.0.1/localhost
  for a device on the same host via adb reverse). Every other destination
  (i.e. production kseal) must use TLS — cleartext is denied by default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
